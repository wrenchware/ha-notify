<Window x:Class="HaNotify.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="HA Notify">
    <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid x:Name="TitleRegion" Background="Transparent" />
        <ScrollViewer x:Name="ScrollArea" Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Left">
            <StackPanel x:Name="PageContent" Margin="32,18,32,28" Spacing="22" HorizontalAlignment="Left">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="64" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Width="64" Height="64" CornerRadius="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Image Source="Assets/ha-notify.png" Width="44" Height="44" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="HA Notify" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="Home Assistant notifications for Windows." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>

                <InfoBar x:Name="ConnectionStatus" IsOpen="True" IsClosable="False" Severity="Informational" Title="Not connected" Message="Add your Home Assistant connection below." />

                <Border CornerRadius="12" Padding="24" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="18">
                        <TextBlock Text="Connection settings" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <TextBox x:Name="Address" Header="Home Assistant address" PlaceholderText="http://homeassistant.local:8123" InputScope="Url" />
                        <PasswordBox x:Name="Token" Header="Access token" PlaceholderText="Paste your long-lived access token" PasswordRevealMode="Peek" />
                        <TextBlock Text="Create a token in your Home Assistant profile → Security." Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,-10,0,0" TextWrapping="Wrap" />
                        <TextBox x:Name="Device" Header="Device name" PlaceholderText="Office PC" />
                        <Grid ColumnSpacing="12" Margin="0,2,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Button x:Name="ConnectButton" Content="Save &amp; connect" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Height="40" Click="Connect_Click" />
                            <Button Grid.Column="1" Content="Test notification" HorizontalAlignment="Stretch" Height="40" Click="Test_Click" ToolTipService.ToolTip="Tests Windows notifications only, not the Home Assistant connection." />
                        </Grid>
                        <TextBlock x:Name="DeliveryStatus" Visibility="Collapsed" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </Border>

                <Border CornerRadius="12" Padding="20,16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="Start with Windows" FontWeight="SemiBold" />
                            <TextBlock Text="Start in the tray when you sign in to Windows." Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch x:Name="Startup" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" AutomationProperties.Name="Start when I sign in to Windows" Toggled="Startup_Toggled" />
                    </Grid>
                </Border>
                <Grid ColumnSpacing="10" Margin="4,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE946;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Top" Margin="0,3,0,0" />
                    <TextBlock Grid.Column="1" Text="Closing this window keeps notifications running in the tray.&#x0a;Your PC needs to be awake and connected to Home Assistant." Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
